# Copy this file to .env and fill in the values for the platforms you use.
# You only need to configure the platforms you actually want to control.
# The server treats any platform with missing credentials as "not connected".

# ---------- TikTok Ads (TikTok Marketing API) ----------
# Create an app at https://business-api.tiktok.com/ and complete OAuth to get a token.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ---------- Google Ads ----------
# Developer token: Google Ads > Tools > API Center (requires a manager account).
GOOGLE_ADS_DEVELOPER_TOKEN=
# Option A: paste a short-lived OAuth access token directly (expires ~1h):
GOOGLE_ADS_ACCESS_TOKEN=
# Option B (recommended): supply a refresh token + OAuth client so the server
# mints access tokens automatically.
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Your manager (MCC) account id and the account you operate on, digits only.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# ---------- Pinterest Ads (API v5) ----------
# Create an app at https://developers.pinterest.com/ with ads:read + ads:write scopes.
PINTEREST_ACCESS_TOKEN=
PINTEREST_AD_ACCOUNT_ID=
