# TikTok Ads MCP — copy to .env and fill in.
# Get a token by creating an app at https://business-api.tiktok.com/ and
# completing the TikTok for Business OAuth flow.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# --- HTTP / remote connector options (only needed for `--http` mode) ---
PORT=3001
# MCP_PATH=/mcp
# Protect the public endpoint with a bearer token (strongly recommended):
# MCP_AUTH_TOKEN=choose-a-long-random-string
