# Google Ads MCP — copy to .env and fill in.
# Developer token: Google Ads > Tools & Settings > API Center (needs a manager/MCC account).
GOOGLE_ADS_DEVELOPER_TOKEN=

# Option A: paste a short-lived OAuth access token (expires ~1h):
GOOGLE_ADS_ACCESS_TOKEN=
# Option B (recommended): refresh token + OAuth client so tokens auto-refresh.
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Manager (MCC) account id and the account you operate on, digits only.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# --- HTTP / remote connector options (only needed for `--http` mode) ---
PORT=3002
# MCP_PATH=/mcp
# MCP_AUTH_TOKEN=choose-a-long-random-string
