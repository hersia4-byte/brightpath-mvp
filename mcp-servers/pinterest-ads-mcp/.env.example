# Pinterest Ads MCP — copy to .env and fill in.
# Create an app at https://developers.pinterest.com/ with ads:read, ads:write,
# pins:read, pins:write scopes, then complete OAuth to get an access token.
PINTEREST_ACCESS_TOKEN=
PINTEREST_AD_ACCOUNT_ID=

# For the one-click /auth "Connect" helper (from your Pinterest developer app):
# register https://<your-service>/auth/callback as the app's redirect URI.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- HTTP / remote connector options (only needed for `--http` mode) ---
PORT=3003
# MCP_PATH=/mcp
# MCP_AUTH_TOKEN=choose-a-long-random-string
